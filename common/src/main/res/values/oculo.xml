<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: Home behaviour. These defaults keep upstream's behaviour; the oculo flavor overrides them in
     smarttubetv/src/oculo/res/values/oculo_config.xml. Strings: EN here, FR in values-fr/oculo.xml,
     other languages fall back to EN. -->
<resources>
    <integer name="oculo_home_refresh_minutes">180</integer>
    <bool name="oculo_home_rows_filter_default">true</bool>
    <bool name="oculo_home_hide_watched_default">true</bool>
    <!-- Home's second row « Continue watching » (OculoContinueWatching); upstream has no such row -->
    <bool name="oculo_home_continue_watching_default">false</bool>
    <!-- Home's background glow takes the focused thumbnail's color (OculoGlow; only where the theme uses
         Oculo's glow background, i.e. the oculo flavor's Dark Grey scheme) -->
    <bool name="oculo_thumbnail_glow_default">false</bool>
    <!-- Rail: Abricot dot on the Subscriptions icon when subscribed channels have new content (OculoNewContent:
         one request with Home's refresh, never in the background). Off upstream. -->
    <bool name="oculo_rail_new_content_dot">false</bool>
    <!-- About: "Install bridge" button (ATV/Amazon voice-search bridge) -->
    <bool name="oculo_show_install_bridge">true</bool>

    <!-- SponsorBlock segment colors on the seek bar (SponsorBlockData; upstream values). Users can only turn
         the markers on or off, not pick colors, so these are the colors. -->
    <color name="oculo_sb_sponsor">@color/green</color>
    <color name="oculo_sb_intro">@color/cyan</color>
    <color name="oculo_sb_outro">@color/blue</color>
    <color name="oculo_sb_self_promo">@color/yellow</color>
    <color name="oculo_sb_interaction">@color/magenta</color>
    <color name="oculo_sb_music_off_topic">@color/orange_peel</color>
    <color name="oculo_sb_preview_recap">@color/light_blue</color>
    <color name="oculo_sb_poi_highlight">@color/light_pink</color>
    <color name="oculo_sb_filler">@color/electric_violet</color>

    <!-- Player: in-player notice when SponsorBlock auto-skips a segment (OculoSkipNotice) instead of the toast.
         Off upstream; the oculo flavor turns it on with an Abricot bar. -->
    <bool name="oculo_skip_notice">false</bool>
    <color name="oculo_skip_notice_background">#E0141414</color>
    <color name="oculo_skip_notice_accent">#FFFFFFFF</color>
    <item name="oculo_skip_notice_hide" type="id"/>

    <string name="oculo_home_rows_filter">Hide news and sports rows</string>
    <string name="oculo_home_hide_watched">Hide watched videos in the first row</string>
    <string name="oculo_home_continue_watching">Show Continue watching</string>
    <string name="oculo_continue_watching">Continue watching</string>
    <string name="oculo_continue_watching_remove">Remove from Continue watching</string>
    <string name="oculo_thumbnail_glow">Glow from the thumbnail</string>
    <!-- Top bar mic button (OculoTopBar) -->
    <string name="oculo_voice_search">Search by voice</string>
    <!-- In-player SponsorBlock notice (OculoSkipNotice); %s = segment category -->
    <string name="oculo_segment_skipped">Skipped: %s</string>
</resources>
