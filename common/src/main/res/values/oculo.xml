<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: Home behaviour. These defaults keep upstream's behaviour; the oculo flavor overrides them in
     smarttubetv/src/oculo/res/values/oculo_config.xml. Strings: EN here, FR in values-fr/oculo.xml,
     other languages fall back to EN. -->
<resources>
    <integer name="oculo_home_refresh_minutes">180</integer>
    <bool name="oculo_home_rows_filter_default">true</bool>
    <bool name="oculo_home_hide_watched_default">true</bool>
    <!-- Home's second row « Continue watching » (OculoContinueWatching); upstream has no such row -->
    <bool name="oculo_home_continue_watching_default">false</bool>
    <!-- Home's background glow takes the focused thumbnail's color (OculoGlow; only where the theme uses
         Oculo's glow background, i.e. the oculo flavor's Dark Grey scheme) -->
    <bool name="oculo_thumbnail_glow_default">false</bool>
    <!-- Rail: Abricot dot on the Subscriptions icon when subscribed channels have new content (OculoNewContent:
         one request with Home's refresh, never in the background). Off upstream. -->
    <bool name="oculo_rail_new_content_dot">false</bool>
    <!-- About: "Install bridge" button (ATV/Amazon voice-search bridge) -->
    <bool name="oculo_show_install_bridge">true</bool>
    <!-- Rail: remove Kids and My videos once (OculoSections: they can't show anything for a regular account) -->
    <bool name="oculo_hide_dead_sections">false</bool>
    <!-- Android TV home-screen channels (leanbackassistant's « Update channels » work, every 15 min in the
         background). OculoBackground cancels it when false. -->
    <bool name="oculo_tv_channels">true</bool>
    <!-- Settings > User interface: « Buttons at the top of the main window » (Search, Language, Accounts).
         With Oculo's rail and top bar none of them has an effect: the category is left out when true. -->
    <bool name="oculo_hide_top_buttons_setting">false</bool>
    <!-- Settings (0.11.0, OculoSettingsCleanup): leave out settings that do nothing on the TV, the second copies of
         duplicated settings and all color schemes but Dark Grey and Dark Grey (OLED). -->
    <bool name="oculo_settings_cleanup">false</bool>
    <!-- Settings (0.11.0, OculoSettingsTiles): 7 categories by intention (+ Advanced in advanced mode) instead of
         upstream's 13 tiles; same preferences. -->
    <bool name="oculo_settings_tiles">false</bool>
    <!-- Settings (0.11.0, OculoSettingsFragment): categories at left, their settings at right, instead of the tile
         grid. Needs oculo_settings_tiles. -->
    <bool name="oculo_settings_screen">false</bool>
    <!-- Idle screen dimming (screensaver) default delay, seconds (OculoScreensaver; upstream 60) -->
    <integer name="oculo_screensaver_timeout_default_sec">60</integer>
    <!-- About title: SmartTube version Oculo is built on. Generated by smarttubetv/oculo.gradle (resValue) in the
         oculo flavor; empty upstream (About keeps « SmartTube 32.74 »). -->
    <string name="oculo_upstream_version" translatable="false"></string>
    <!-- %1$s = « Oculo 0.9.0 », %2$s = SmartTube version (« 32.74 ») -->
    <string name="oculo_about_based_on">%1$s · based on SmartTube %2$s</string>

    <!-- SponsorBlock segment colors on the seek bar (SponsorBlockData; upstream values). Users can only turn
         the markers on or off, not pick colors, so these are the colors. -->
    <color name="oculo_sb_sponsor">@color/green</color>
    <color name="oculo_sb_intro">@color/cyan</color>
    <color name="oculo_sb_outro">@color/blue</color>
    <color name="oculo_sb_self_promo">@color/yellow</color>
    <color name="oculo_sb_interaction">@color/magenta</color>
    <color name="oculo_sb_music_off_topic">@color/orange_peel</color>
    <color name="oculo_sb_preview_recap">@color/light_blue</color>
    <color name="oculo_sb_poi_highlight">@color/light_pink</color>
    <color name="oculo_sb_filler">@color/electric_violet</color>

    <!-- Player: in-player notice when SponsorBlock auto-skips a segment (OculoSkipNotice) instead of the toast.
         Off upstream; the oculo flavor turns it on with an Abricot bar. -->
    <bool name="oculo_skip_notice">false</bool>
    <color name="oculo_skip_notice_background">#E0141414</color>
    <color name="oculo_skip_notice_accent">#FFFFFFFF</color>
    <item name="oculo_skip_notice_hide" type="id"/>

    <string name="oculo_home_rows_filter">Hide news and sports rows</string>
    <string name="oculo_home_hide_watched">Hide watched videos in the first row</string>
    <string name="oculo_home_continue_watching">Show Continue watching</string>
    <string name="oculo_continue_watching">Continue watching</string>
    <string name="oculo_continue_watching_remove">Remove from Continue watching</string>
    <string name="oculo_thumbnail_glow">Glow from the thumbnail</string>
    <!-- Top bar mic button (OculoTopBar) -->
    <string name="oculo_voice_search">Search by voice</string>
    <!-- In-player SponsorBlock notice (OculoSkipNotice); %s = segment category -->
    <string name="oculo_segment_skipped">Skipped: %s</string>
    <!-- Audio (OculoAudioTracks): default track = the original (no voice boost, no stable volume, original
         language), clearer names and originals first in the « Audio formats » list. Off upstream. -->
    <bool name="oculo_audio_original">false</bool>
    <!-- « Audio formats » list names; %1$s = bitrate in Mb/s, already localized (0.16 / 0,16) -->
    <string name="oculo_audio_bitrate">%1$s Mb/s</string>
    <string name="oculo_audio_label_original">Original</string>
    <string name="oculo_audio_label_voice_boost">Voice boost</string>
    <string name="oculo_audio_label_stable_volume">Stable volume</string>
    <string name="oculo_audio_label_dubbed">Dubbed</string>
    <string name="oculo_audio_label_auto_dubbed">Auto-dubbed</string>
    <string name="oculo_audio_label_descriptive">Audio description</string>
    <string name="oculo_audio_label_secondary">Secondary</string>

    <!-- Oculo panel (0.12.0, docs/mockups/drawers/drawers-redesign.html): every drawer becomes the Settings card
         floating at the right (OculoPanel). Upstream look when false; the oculo flavor sets it true. -->
    <bool name="oculo_panel">false</bool>
    <string name="oculo_panel_playback">Playback</string>
    <string name="oculo_panel_comments">Comments</string>
    <string name="oculo_panel_replies">Replies</string>
    <string name="oculo_panel_about_video">About this video</string>
    <string name="oculo_panel_skip_in">in %d s</string>
    <string name="oculo_panel_account">Account</string>
    <string name="oculo_panel_accounts">Accounts on this TV: %d</string>
    <string name="oculo_panel_search">Search</string>
    <string name="oculo_panel_channel">Channel</string>
</resources>
