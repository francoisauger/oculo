<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0): one category of the Settings screen (left list): outline icon, name (Roboto Condensed) and a
     one-line summary of its values (Roboto). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/oculo_settings_category_height"
    android:layout_marginBottom="@dimen/oculo_settings_category_gap"
    android:background="@drawable/oculo_settings_pill_focus"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/oculo_settings_icon"
        android:layout_width="@dimen/oculo_settings_category_icon"
        android:layout_height="@dimen/oculo_settings_category_icon"
        android:layout_marginEnd="11dp"
        android:duplicateParentState="true"
        android:tint="@color/oculo_settings_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/oculo_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed"
            android:singleLine="true"
            android:textColor="@color/oculo_settings_title"
            android:textSize="@dimen/oculo_settings_category_title" />

        <TextView
            android:id="@+id/oculo_settings_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:textColor="@color/oculo_settings_summary"
            android:textSize="@dimen/oculo_settings_category_summary" />
    </LinearLayout>

    <View
        android:id="@+id/oculo_settings_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="6dp"
        android:visibility="gone" />
</LinearLayout>
