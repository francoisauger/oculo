<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: comments panel item (OculoComments.holders(), flag oculo_comments_airy), from chatkit's
     item_incoming_text_message.xml (same ids, same holder). Google TV / YouTube TV style, calm and airy:
     20dp side margins (the panel header's, oculo_card_padding_h; 24dp before 0.12.0), 14dp between comments, 30dp avatar aligned with the meta line,
     12dp / 16dp inside the bubble (chatkit applies the list's 10sp bubble padding, the text adds the rest),
     regular sans-serif body (upstream: condensed, 0.9 line spacing) with 1.28 line spacing, focus ring. -->
<com.stfalcon.chatkit.commons.widgets.FocusFixRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:layout_marginLeft="@dimen/oculo_card_padding_h"
    android:layout_marginStart="@dimen/oculo_card_padding_h"
    android:layout_marginRight="@dimen/oculo_card_padding_h"
    android:layout_marginEnd="@dimen/oculo_card_padding_h"
    android:layout_marginTop="0dp"
    android:focusable="false">

    <com.stfalcon.chatkit.utils.ShapeImageView
        android:id="@id/messageUserAvatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginRight="12dp" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@id/bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/messageUserAvatar"
        android:layout_toRightOf="@id/messageUserAvatar"
        android:duplicateParentState="true"
        android:foreground="@drawable/oculo_comment_focus_ring"
        android:orientation="vertical"
        app:alignContent="stretch"
        app:alignItems="stretch"
        app:flexWrap="wrap"
        app:justifyContent="flex_start">

        <!-- Messages exceeding certain length cause crashes (upstream note): maxLines 50 kept -->
        <TextView
            android:id="@id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingLeft="6dp"
            android:paddingEnd="6dp"
            android:paddingRight="6dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.28"
            android:maxLines="50" />

        <TextView
            android:id="@id/messageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/messageText"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            app:layout_alignSelf="center" />

    </com.google.android.flexbox.FlexboxLayout>

</com.stfalcon.chatkit.commons.widgets.FocusFixRelativeLayout>
