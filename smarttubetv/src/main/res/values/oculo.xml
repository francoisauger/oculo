<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: resources read by upstream code through small Oculo hooks. Values here keep upstream's look;
     the oculo flavor overrides them in smarttubetv/src/oculo/res. -->
<resources>
    <!-- Remaining (not yet buffered) part of the player seek bar (SeekBar.java; upstream Color.GRAY) -->
    <color name="oculo_seek_bar_remaining">#FF888888</color>
    <!-- Text on accent card badges (LIVE, NEW, upcoming; ComplexImageView). Transparent = keep upstream's -->
    <color name="oculo_badge_accent_text">#00000000</color>
    <!-- Background of channel cards with new content (ChannelCardPresenter; upstream dark_red) -->
    <color name="oculo_channel_new_content">@color/dark_red</color>
    <!-- Sign-in screen (SignInFragment): code text (transparent = keep upstream's) and URL (upstream red) -->
    <color name="oculo_signin_code">#00000000</color>
    <color name="oculo_signin_link">@color/red</color>
    <!-- Tag key: a badge's original text colors (OculoUi.tintBadgeText) -->
    <item name="oculo_badge_text_colors" type="id" />

    <!-- Left rail (OculoRail, hooked into BrowseFragment): YouTube-style icon column that stays on screen and
         expands with labels when focused. Off upstream; the oculo flavor turns it on. -->
    <bool name="oculo_left_rail">false</bool>
    <!-- Opacity of unfocused section headers (IconHeaderItemPresenter; upstream: leanback's 50%) -->
    <item name="oculo_header_unselect_alpha" type="fraction">@fraction/lb_browse_header_unselect_alpha</item>
    <!-- Width kept on screen while collapsed: the content container starts there and the rows keep their
         own 56dp padding, so the first card starts 94dp from the edge. 32.74-11: icon column 20 % wider than
         YouTube TV's 78dp (156 px at 1080p; François found it narrow), i.e. 22dp -> 38dp here, icons and avatar
         recentered (+8dp, oculo_rail_list_padding_start). Scrolled cards are clipped at
         oculo_rail_content_clip_start (container coordinates, just right of the icons; 34dp until 32.74-10). -->
    <dimen name="oculo_rail_collapsed_width">38dp</dimen>
    <dimen name="oculo_rail_content_clip_start">26dp</dimen>
    <!-- 32.74-15, reworked in 32.74-16 (OculoRowEdge): while a row is scrolled, its cards are cut at the content's
         start line (the row's start padding, where the first card sits) instead of oculo_rail_content_clip_start,
         by the row grid's clip bounds (hard cut, no fade). Off upstream. -->
    <bool name="oculo_row_edge_clip">false</bool>
    <item name="oculo_row_edge" type="id" />
    <!-- Geometry measured on YouTube TV (1080p screenshots in docs/mockups/youtube-ref/, 2 px = 1dp):
         avatar centered 50.75dp from the top (fixed, never scrolls); the section list is clipped 77.5dp from
         the top; Search is the list's first slot and scrolls away with the sections. Collapsed: Search centered
         116.75dp from the top, sections every 39dp after it. Expanded: the whole list moves up 19.5dp
         (Search 97.25dp, Home 136.25dp). -->
    <dimen name="oculo_rail_avatar_center">50.75dp</dimen>
    <dimen name="oculo_rail_list_clip_top">77.5dp</dimen>
    <dimen name="oculo_rail_list_top">58.75dp</dimen>
    <dimen name="oculo_rail_expanded_shift">19.5dp</dimen>
    <dimen name="oculo_rail_list_bottom">28dp</dimen>
    <!-- Once the list has scrolled, sections fade out over this height just below the avatar instead of being
         cut sharply (YouTube's list scrolls by whole items; leanback's centers the focused one) -->
    <dimen name="oculo_rail_list_fade">22dp</dimen>
    <dimen name="oculo_rail_item_height">39dp</dimen>
    <dimen name="oculo_rail_item_spacing">0dp</dimen>
    <!-- Icon centered 46.75dp from the edge, label starting 69dp from the edge (32.74-11, centered in the wider
         94dp column; YouTube: 77.5 px, 123 px, i.e. 38.75dp and 61dp with list padding 16dp) -->
    <dimen name="oculo_rail_list_padding_start">24dp</dimen>
    <dimen name="oculo_rail_item_padding_start">13dp</dimen>
    <dimen name="oculo_rail_list_padding_end">24dp</dimen>
    <dimen name="oculo_rail_icon_size">20dp</dimen>
    <dimen name="oculo_rail_avatar_size">27dp</dimen>
    <dimen name="oculo_rail_label_margin">12dp</dimen>
    <!-- Focused item: YouTube's white rounded rectangle, 444 x 78 px with 15 px corners -->
    <dimen name="oculo_rail_pill_radius">7.5dp</dimen>
    <!-- Focused pill width (YouTube: 444 px) -->
    <dimen name="oculo_rail_pill_width">222dp</dimen>
    <!-- Expanded rail: duration of the list's upward move -->
    <integer name="oculo_rail_shift_duration">200</integer>

    <!-- Top bar (OculoTopBar): mic button + "Search" pill at the content's start, clock, date and wordmark at
         the top right, all centered 50.75dp from the top (YouTube: 101.5 px). YouTube: mic 72 px circle,
         pill 630 x 72 px, 18 px apart; logo 44 px high. The bar stays while the rows scroll, as in YouTube;
         the content is clipped under it. -->
    <dimen name="oculo_top_bar_height">36dp</dimen>
    <dimen name="oculo_top_bar_pill_width">315dp</dimen>
    <dimen name="oculo_top_bar_gap">9dp</dimen>
    <dimen name="oculo_top_bar_icon_size">20dp</dimen>
    <dimen name="oculo_top_bar_text_inset">17dp</dimen>
    <dimen name="oculo_top_bar_text_size">18sp</dimen>
    <dimen name="oculo_top_bar_logo_height">28dp</dimen>
    <dimen name="oculo_top_bar_logo_margin">14dp</dimen>
    <dimen name="oculo_top_bar_time_size">18sp</dimen>
    <dimen name="oculo_top_bar_date_size">11sp</dimen>
    <dimen name="oculo_top_bar_content_clip">75dp</dimen>
    <!-- YouTube's focus white and the dark ink on it (measured: #F1F1F1, #0F0F0F): focused rail item, mic and
         Search pill (32.74-8; before: turquoise) -->
    <color name="oculo_white_focus">#F1F1F1</color>
    <color name="oculo_white_focus_ink">#0F0F0F</color>
    <!-- Top bar colors: white 15% at rest (YouTube #272727 on its #0F0F0F), white with dark text and icon when
         focused, as in YouTube -->
    <color name="oculo_top_bar_button">#26FFFFFF</color>
    <color name="oculo_top_bar_button_focused">@color/oculo_white_focus</color>
    <color name="oculo_top_bar_text">#BFFFFFFF</color>
    <color name="oculo_top_bar_text_focused">@color/oculo_white_focus_ink</color>

    <!-- Focus ring of video and channel cards (OculoUi.setCardFocusFrame): ring color, width and gap.
         Transparent = no ring (upstream); the oculo flavor sets them. -->
    <color name="oculo_card_focus_ring">#00000000</color>
    <dimen name="oculo_card_focus_ring_width">0dp</dimen>
    <dimen name="oculo_card_focus_ring_gap">0dp</dimen>
    <!-- The focused card's ring pulses (Google TV): full, down to this opacity, back to full, over this period
         (cosine ease in-out). 0 = steady ring (upstream); the oculo flavor sets them in oculo_config.xml. -->
    <integer name="oculo_card_focus_pulse_period">0</integer>
    <item name="oculo_card_focus_pulse_min_alpha" type="fraction">100%</item>
    <!-- 32.74-13: ring + gap OUTSIDE the tile and a soft glow in the thumbnail's color around it (OculoUi.CardFrame,
         one drawable in the grid item's overlay; tag key below). Glow: blur reach beyond the ring, peak opacity, and
         the share of it used for the white fallback when the thumbnail has no usable color. 0 = no glow (upstream). -->
    <item name="oculo_card_frame" type="id" />
    <dimen name="oculo_card_glow_radius">0dp</dimen>
    <item name="oculo_card_glow_alpha" type="fraction">0%</item>
    <item name="oculo_card_glow_fallback_alpha" type="fraction">100%</item>
    <!-- No info box under video and channel cards (title and meta on the page, Google TV / YouTube); only applies
         with the focus ring and no focus fill (OculoUi.cardInfoBackground). Off upstream. -->
    <bool name="oculo_card_hide_info_box">false</bool>
    <!-- No elevation shadow under cards that have the focus ring (OculoUi.CardFrame): leanback's dynamic shadow
         (ShadowOverlayHelper, focused Z 10dp) is cast from the whole card's outline and shows as a black area under
         the title and meta once the info box is transparent. Off upstream (shadow kept). -->
    <bool name="oculo_card_no_shadow">false</bool>
    <!-- Meta line under a card (channel • views • date). Transparent = the card's text color (upstream). -->
    <color name="oculo_card_meta_text">#00000000</color>
    <!-- Rail: new-content dot on the Subscriptions icon (OculoRail, OculoNewContent; flag in common's oculo.xml) -->
    <item name="oculo_rail_dot" type="id" />
    <dimen name="oculo_rail_dot_size">7dp</dimen>
    <dimen name="oculo_rail_dot_outline">1.5dp</dimen>
    <color name="oculo_rail_dot">#FFA25C</color>
    <color name="oculo_rail_dot_outline">#131313</color>
    <!-- Card meta line accents (OculoUi.accentCardMeta): live viewer count and publish time under 24 h.
         Transparent = unchanged (upstream); the oculo flavor sets Abricot in oculo_config.xml. -->
    <color name="oculo_card_live_viewers">#00000000</color>
    <color name="oculo_card_recent_time">#00000000</color>
</resources>
