<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo panel (0.12.0): text field as a pill (white 8 %), turquoise outline when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="@color/oculo_card_teal" />
            <corners android:radius="@dimen/oculo_card_pill_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="@dimen/oculo_card_pill_radius" />
        </shape>
    </item>
</selector>
