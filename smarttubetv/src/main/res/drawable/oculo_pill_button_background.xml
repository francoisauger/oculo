<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: pill button (empty states, sign-in), the top bar's colors: white 15 % at rest, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_top_bar_button_focused" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_top_bar_button" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
