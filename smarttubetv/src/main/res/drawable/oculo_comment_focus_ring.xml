<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: focused comment = the white ring of Oculo's cards (2dp #F1F1F1), drawn as the bubble's foreground.
     The bubble takes the item's focused state (duplicateParentState in layout/oculo_comment_item.xml). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/message_bubble_corners_radius" />
            <stroke android:width="2dp" android:color="#F1F1F1" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
