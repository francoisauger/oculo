<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0): Settings rows. Focus = white pill (as in the rail and the top bar); activated = the category
     whose settings are open on the right (white 9 %). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_white_focus" />
            <corners android:radius="@dimen/oculo_card_pill_radius" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_settings_selected" />
            <corners android:radius="@dimen/oculo_card_pill_radius" />
        </shape>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
