<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo top bar: round mic button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/oculo_top_bar_button_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/oculo_top_bar_button" />
        </shape>
    </item>
</selector>
