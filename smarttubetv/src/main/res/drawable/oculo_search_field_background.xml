<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: text field as a white 15 % pill (search screen, channels filter); a 2dp white ring while typing in it
     (focused state, the field's container takes its children's states). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_top_bar_button" />
            <stroke android:width="2dp" android:color="@color/oculo_white_focus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_top_bar_button" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
