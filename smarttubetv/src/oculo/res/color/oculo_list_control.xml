<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0, M1): radio buttons and check boxes. Dark ink on the white focus pill (turquoise on white is too
     faint), turquoise when checked, grey otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/oculo_white_focus_ink" />
    <item android:state_checked="true" android:color="@color/oculo_turquoise" />
    <item android:color="#AAAAAA" />
</selector>
