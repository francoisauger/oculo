<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo left rail icons: deep teal on the focused pill, turquoise for the current section, white 70% otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/oculo_deep_dark" />
    <item android:state_activated="true" android:color="@color/oculo_turquoise" />
    <item android:color="#B3FFFFFF" />
</selector>
