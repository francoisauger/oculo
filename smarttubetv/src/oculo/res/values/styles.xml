<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo accents for the default color scheme ("Dark Grey", index 1 in MainUIData). These styles replace the
     upstream ones of the same name (smarttubetv/src/main/res/values/styles.xml): every item is restated, with
     upstream's red accents swapped for Oculo turquoise. Since 32.74-8 focused video and channel cards have no fill
     (cardSelectedBackground = the card's own background, white text) but a dark-teal contour (OculoUi). Browse screens get a subtle turquoise glow on black
     (shelfBackground, drawable/oculo_browse_background.xml); the player and the OLED variant stay pure black.
     The OLED and monochrome variants inherit from these; the Red and Blue schemes are untouched.
     Player: option 1 "Sarcelle profonde" of docs/mockups/player-colors.html (played #0FA3A0, buffered #E0E6E5,
     active icons #12B3AC; focused button disc in drawable-v21/lb_control_button_*.xml). -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="App.Theme.DarkGrey.Player" parent="App.Theme.Leanback.Player">
        <item name="playbackProgressPrimaryColor">@color/oculo_seek_played</item>
        <item name="playbackProgressSecondaryColor">@color/oculo_seek_buffered</item>
        <item name="playbackControlsIconHighlightColor">@color/oculo_icon_active</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/scheme_grey_card_background_dark</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/oculo_turquoise</item>
    </style>
    <style name="App.Theme.DarkGrey.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="brandColor">@color/scheme_grey_background_dark</item>
        <!-- Search orb: white icon on it, so the darker teal -->
        <item name="brandAccentColor">@color/oculo_teal</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
        <!-- Black with the logo board's subtle turquoise glow (drawable/oculo_browse_background.xml) -->
        <item name="shelfBackground">@drawable/oculo_browse_background</item>
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/scheme_grey_card_background_dark</item>
        <!-- Top-right badge: the "Oculo" wordmark (white letters), mipmap-nodpi/app_logo_semi_red.png -->
        <item name="appLogo">@mipmap/app_logo_semi_red</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/oculo_turquoise</item>
    </style>
    <!-- Upstream style restated so the OLED variant keeps a pure black background (no glow) -->
    <style name="App.Theme.DarkGrey.OLED.Browse" parent="App.Theme.DarkGrey.Browse">
        <item name="brandAccentColor">@color/semi_transparent</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
        <item name="appLogo">@null</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
    </style>
    <style name="ProgressBarHorizontal.Dark" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_oculo</item>
    </style>
    <style name="App.Theme.DarkGrey.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="android:colorPrimary" tools:targetApi="21">@color/scheme_grey_background</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/oculo_turquoise</item>
    </style>
    <!-- Oculo panel (0.12.0): the Android dialogs that remain (SimpleEditDialog: playlist and section names,
         passwords, custom audio delay; WebProxyDialog) take the panel's look. Restates sharedutils' AppDialog (same
         items) on a dark base: the card as window, Roboto Condensed title, buttons as pills (white when focused),
         dim like the panel's scrim. Fields: flavor copies of simple_edit_dialog.xml and web_proxy_dialog.xml. -->
    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/oculo_dialog_background</item>
        <item name="android:backgroundDimAmount">0.58</item>
        <item name="android:textColor">@color/oculo_card_title_text</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="colorPrimaryDark">@color/oculo_card_teal</item>
        <item name="colorPrimary">@color/oculo_card_teal</item>
        <item name="colorAccent">@color/oculo_card_teal</item>
        <item name="android:selectableItemBackground">@drawable/oculo_list_focus</item>
        <item name="android:textColorPrimary">@color/oculo_card_title_text</item>
        <item name="android:textColorSecondary">@color/oculo_card_secondary</item>
        <item name="android:windowTitleStyle">@style/OculoDialogTitle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogButtonStyle</item>
    </style>
    <style name="AppDialogButtonStyle">
        <item name="android:textColor">@color/oculo_dialog_button_text</item>
        <item name="android:background">@drawable/oculo_dialog_button</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">@dimen/oculo_card_row_title</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical|center_horizontal</item>
    </style>
    <style name="OculoDialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/OculoDialogTitleText</item>
    </style>
    <style name="OculoDialogTitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/oculo_card_title</item>
        <item name="android:textColor">@color/oculo_card_title_text</item>
    </style>
    <!-- Text field of those dialogs: a pill, Roboto, the card's colors -->
    <style name="OculoDialogField">
        <item name="android:background">@drawable/oculo_dialog_field</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/oculo_card_title_text</item>
        <item name="android:textColorHint">#80FFFFFF</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
