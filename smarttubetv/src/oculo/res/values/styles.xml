<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo accents for the default color scheme ("Dark Grey", index 1 in MainUIData). These styles replace the
     upstream ones of the same name (smarttubetv/src/main/res/values/styles.xml): every item is restated, with
     upstream's red accents swapped for Oculo turquoise. Since 32.74-8 focused video and channel cards have no fill
     (cardSelectedBackground = the card's own background, white text) but a dark-teal contour (OculoUi). Browse screens get a subtle turquoise glow on black
     (shelfBackground, drawable/oculo_browse_background.xml); the player and the OLED variant stay pure black.
     The OLED and monochrome variants inherit from these; the Red and Blue schemes are untouched.
     Player: option 1 "Sarcelle profonde" of docs/mockups/player-colors.html (played #0FA3A0, buffered #E0E6E5,
     active icons #12B3AC; focused button disc in drawable-v21/lb_control_button_*.xml). -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="App.Theme.DarkGrey.Player" parent="App.Theme.Leanback.Player">
        <item name="playbackProgressPrimaryColor">@color/oculo_seek_played</item>
        <item name="playbackProgressSecondaryColor">@color/oculo_seek_buffered</item>
        <item name="playbackControlsIconHighlightColor">@color/oculo_icon_active</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/scheme_grey_card_background_dark</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/oculo_turquoise</item>
    </style>
    <style name="App.Theme.DarkGrey.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="brandColor">@color/scheme_grey_background_dark</item>
        <!-- Search orb: white icon on it, so the darker teal -->
        <item name="brandAccentColor">@color/oculo_teal</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
        <!-- Black with the logo board's subtle turquoise glow (drawable/oculo_browse_background.xml) -->
        <item name="shelfBackground">@drawable/oculo_browse_background</item>
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="cardSelectedBackground">@color/scheme_grey_card_background_dark</item>
        <!-- Top-right badge: the "Oculo" wordmark (white letters), mipmap-nodpi/app_logo_semi_red.png -->
        <item name="appLogo">@mipmap/app_logo_semi_red</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/oculo_turquoise</item>
    </style>
    <!-- Upstream style restated so the OLED variant keeps a pure black background (no glow) -->
    <style name="App.Theme.DarkGrey.OLED.Browse" parent="App.Theme.DarkGrey.Browse">
        <item name="brandAccentColor">@color/semi_transparent</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
        <item name="appLogo">@null</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
    </style>
    <style name="ProgressBarHorizontal.Dark" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_oculo</item>
    </style>
    <style name="App.Theme.DarkGrey.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="android:colorPrimary" tools:targetApi="21">@color/scheme_grey_background</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/oculo_turquoise</item>
    </style>
</resources>
