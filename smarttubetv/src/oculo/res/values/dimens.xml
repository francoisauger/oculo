<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo: player seek bar, option 1 "Sarcelle profonde" (docs/mockups/player-colors.html). -->
<resources>
    <!-- Seek bar height when focused (leanback: 6dp) -->
    <dimen name="lb_playback_transport_progressbar_active_bar_height">8dp</dimen>
    <!-- Knob radius when focused, keeps the knob in proportion with the thicker bar (leanback: 6dp) -->
    <dimen name="lb_playback_transport_progressbar_active_radius">8dp</dimen>
    <!-- Turquoise ring around the focused player button -->
    <dimen name="oculo_control_button_ring">3dp</dimen>
    <!-- Left rail: the focused section is a pill, not zoomed (leanback: 1.2) -->
    <item format="float" name="lb_browse_header_select_scale" type="dimen">1.0</item>
    <!-- Left rail and top bar (OculoRail, OculoTopBar), YouTube TV proportions: expanded content starts 267dp
         from the edge (211dp container margin + the rows' 56dp padding; upstream SmartTube 265dp + 56dp) and
         the first row title sits 18dp higher under the slimmer top bar (upstream SmartTube 130dp). -->
    <dimen name="lb_browse_rows_margin_start">211dp</dimen>
    <dimen name="lb_browse_rows_margin_top">112dp</dimen>
    <!-- Focus contour of video cards (32.74-8, OculoUi.setCardFocusFrame): 7dp on the 200 x 110dp thumbnail
         (6.4 % of its height; François's reference frame is thicker, ~15-18 %, on a small icon) -->
    <dimen name="oculo_card_focus_frame_width">7dp</dimen>
    <!-- Channel cards (avatar + title, 30dp high): the frame goes around the whole card, thinner -->
    <dimen name="oculo_channel_card_focus_frame_width">4dp</dimen>
</resources>
