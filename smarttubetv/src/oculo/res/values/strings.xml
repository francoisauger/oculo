<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo branding. Overrides strings from the app module and from the library modules (common, leanbackassistant). -->
<resources>
    <string translatable="false" name="app_name"><![CDATA[Oculo]]></string>
    <string translatable="false" name="browse_title"><![CDATA[Oculo]]></string>

    <!-- leanbackassistant: global search -->
    <string translatable="false" name="search_label">Oculo</string>
    <string translatable="false" name="settings_description">Oculo videos</string>
    <!-- Must match applicationId + ".search_provider" (provider authority in leanbackassistant/src/stfdroid/AndroidManifest.xml) -->
    <string translatable="false" name="search_authority">com.francoisauger.oculo.search_provider</string>

    <!-- common: About screen links -->
    <string translatable="false" name="releases_url">https://github.com/francoisauger/oculo/releases</string>
    <string translatable="false" name="sources_url">https://github.com/francoisauger/oculo</string>

    <!-- common: normal case instead of upstream's ALL CAPS (design.md M9); FR in values-fr/strings.xml -->
    <string name="action_signin">Sign in</string>
    <string name="subscriptions_signin_title">The latest from your channels</string>
    <string name="subscriptions_signin_subtitle">Sign in to see your subscriptions</string>
    <string name="subscriptions_signin_button_text">Sign in</string>

    <!-- common: the two themes Oculo keeps (OculoSettingsCleanup): Dark Grey and Dark Grey (OLED) -->
    <string name="color_scheme_dark_grey">Oculo</string>
    <string name="color_scheme_dark_grey_oled">Oculo black (OLED)</string>
</resources>
