<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo loading animation: concept B "Balayage" exactly as docs/mockups/loading.html shows it by default
     (frame toggle "Sarcelle foncé", speed "Réelle"): a cyan -> mint light trail runs around the dark-teal
     O-screen frame, 1.2 s per lap, linear. Overrides the SmartTube spinner (SharedModules/sharedutils
     progress_large_holo), used by ProgressBarManager and the flavor copies of view_loading_card.xml and
     widget_preview_card.xml. API 24+ (gradients); drawable/ holds a solid-color fallback for API 21-23.
     Geometry = the mockup's SVG (viewBox -60 -127.5 980 980). The mockup's diagonal gradients use SVG
     objectBoundingBox units (0,0 -> 1,1 on a non-square box): their end points here are chosen so the
     color lines match (end = start + g / |g|^2, g = (1 / 2w, 1 / 2h)). Frame comparison with the mockup:
     docs/mockups/loading-compare.png. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="76dp"
            android:height="76dp"
            android:viewportWidth="980"
            android:viewportHeight="980">
            <group
                android:translateX="60"
                android:translateY="127.5">
                <!-- Frame: dark teal, gFrameTeal (vertical #145963 -> #0F4A52 -> #0B3A41) -->
                <path android:pathData="M275,0 H585 A275,275 0 0 1 860,275 V450 A275,275 0 0 1 585,725 H275 A275,275 0 0 1 0,450 V275 A275,275 0 0 1 275,0 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="0"
                            android:startY="0"
                            android:endX="0"
                            android:endY="725">
                            <item android:offset="0" android:color="#FF145963" />
                            <item android:offset="0.5" android:color="#FF0F4A52" />
                            <item android:offset="1" android:color="#FF0B3A41" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- Track: rgba(120,245,190,.10) -->
                <path
                    android:pathData="M280,59 H580 A205,205 0 0 1 785,264 V461 A205,205 0 0 1 580,666 H280 A205,205 0 0 1 75,461 V264 A205,205 0 0 1 280,59 Z"
                    android:strokeWidth="56"
                    android:strokeAlpha="0.10"
                    android:strokeColor="#FF78F5BE" />
                <!-- Tail: dash 40 of 100, starts 26 behind the head, 32% opacity -->
                <path
                    android:name="tail"
                    android:pathData="M280,59 H580 A205,205 0 0 1 785,264 V461 A205,205 0 0 1 580,666 H280 A205,205 0 0 1 75,461 V264 A205,205 0 0 1 280,59 Z"
                    android:strokeWidth="56"
                    android:strokeAlpha="0.32"
                    android:strokeLineCap="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0.40"
                    android:trimPathOffset="0.74">
                    <aapt:attr name="android:strokeColor">
                        <gradient
                            android:type="linear"
                            android:startX="75"
                            android:startY="0"
                            android:endX="785"
                            android:endY="0">
                            <item android:offset="0" android:color="#FF2FE3F0" />
                            <item android:offset="1" android:color="#FF78F5BE" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- Head: dash 14 of 100, gTrace (horizontal #2FE3F0 -> #78F5BE) -->
                <path
                    android:name="head"
                    android:pathData="M280,59 H580 A205,205 0 0 1 785,264 V461 A205,205 0 0 1 580,666 H280 A205,205 0 0 1 75,461 V264 A205,205 0 0 1 280,59 Z"
                    android:strokeWidth="56"
                    android:strokeLineCap="round"
                    android:trimPathStart="0"
                    android:trimPathEnd="0.14"
                    android:trimPathOffset="0">
                    <aapt:attr name="android:strokeColor">
                        <gradient
                            android:type="linear"
                            android:startX="75"
                            android:startY="0"
                            android:endX="785"
                            android:endY="0">
                            <item android:offset="0" android:color="#FF2FE3F0" />
                            <item android:offset="1" android:color="#FF78F5BE" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- Screen: gScreen, cyan -> turquoise -> mint, diagonal over the 560 x 489 box -->
                <path android:pathData="M295,118 H565 A145,145 0 0 1 710,263 V462 A145,145 0 0 1 565,607 H295 A145,145 0 0 1 150,462 V263 A145,145 0 0 1 295,118 Z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="150"
                            android:startY="118"
                            android:endX="634.54"
                            android:endY="672.89">
                            <item android:offset="0" android:color="#FF2FE3F0" />
                            <item android:offset="0.55" android:color="#FF22D3C8" />
                            <item android:offset="1" android:color="#FF78F5BE" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- Gloss, clipped to the screen: gGloss, white 34% -> 6%, diagonal over its 560 x 381.42 box -->
                <group>
                    <clip-path android:pathData="M295,118 H565 A145,145 0 0 1 710,263 V462 A145,145 0 0 1 565,607 H295 A145,145 0 0 1 150,462 V263 A145,145 0 0 1 295,118 Z" />
                    <path android:pathData="M150,118 H710 V166.9 Q458,264.7 150,499.42 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="150"
                                android:startY="118"
                                android:endX="504.92"
                                android:endY="639.10">
                                <item android:offset="0" android:color="#57FFFFFF" />
                                <item android:offset="1" android:color="#0FFFFFFF" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="head">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1200"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="trimPathOffset"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="tail">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1200"
                android:interpolator="@android:anim/linear_interpolator"
                android:propertyName="trimPathOffset"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="0.74"
                android:valueTo="1.74"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
