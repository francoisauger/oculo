<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo left rail: focused item = turquoise pill (like the focused card), nothing otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/oculo_turquoise" />
            <corners android:radius="@dimen/oculo_rail_pill_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
