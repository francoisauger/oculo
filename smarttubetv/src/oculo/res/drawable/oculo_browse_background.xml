<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo browse background (home, search, channel...), 32.74-6: one teal glow on the Dark Grey scheme's black,
     top right below the clock and wordmark (preview: docs/mockups/background-glow.png): center 78% / 25%,
     radius 47.5% of the screen width (912 px of 1920 = 84.44%p; %p is a fraction of the smaller side,
     1080 px), turquoise at 20% like the logo board's glow (32.74-4 to -5: centered at 50% / 42%).
     Dithered against banding. Used as shelfBackground of App.Theme.DarkGrey.Browse, which UriBackgroundManager
     draws behind the browse screens; the player keeps its own black background, the OLED theme stays black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/scheme_grey_shelf_background_dark" />
    <item>
        <shape
            android:dither="true"
            android:shape="rectangle">
            <gradient
                android:centerX="0.78"
                android:centerY="0.25"
                android:endColor="#0032E6DC"
                android:gradientRadius="84.44%p"
                android:startColor="#3332E6DC"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
