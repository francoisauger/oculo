<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0, M1; 0.12.0 Oculo panel): flavor copy of the upstream layout, a value of a list at the Settings
     card's sizes: white focus pill, the Settings radio (drawable/oculo_panel_radio), Roboto Condensed title.
     Same ids as upstream. Re-sync if upstream changes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/oculo_list_focus"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/oculo_panel_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/oculo_panel_row_padding"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/oculo_panel_row_padding"
    android:paddingBottom="6dp">

    <RadioButton
        android:id="@+id/button"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="11dp"
        android:background="@null"
        android:button="@drawable/oculo_panel_radio"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false" />

    <TextView
        android:id="@android:id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-condensed"
        android:textColor="@color/oculo_list_title"
        android:textSize="@dimen/oculo_card_row_title" />
</LinearLayout>
