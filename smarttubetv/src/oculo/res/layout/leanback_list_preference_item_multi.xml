<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0, M1; 0.12.0 Oculo panel): flavor copy of the upstream layout, an item of a check list at the
     Settings card's sizes: white focus pill, Roboto Condensed title, the Settings switch at the right
     (drawable/oculo_panel_switch) instead of upstream's check box at the left. Same ids as upstream.
     Re-sync if upstream changes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/oculo_list_focus"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/oculo_panel_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/oculo_panel_row_padding"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/oculo_panel_row_padding"
    android:paddingBottom="6dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:fontFamily="sans-serif-condensed"
        android:textColor="@color/oculo_list_title"
        android:textSize="@dimen/oculo_card_row_title" />

    <CheckBox
        android:id="@+id/button"
        android:layout_width="32dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:background="@null"
        android:button="@drawable/oculo_panel_switch"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false" />
</LinearLayout>
