<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0, M1; 0.12.0 Oculo panel): flavor copy of the upstream layout. The check box of a switch row is the
     Settings card's switch (drawable/oculo_panel_switch), placed at the right by layout/leanback_preference.
     Re-sync if upstream changes it. -->
<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/checkbox"
    android:layout_width="32dp"
    android:layout_height="18dp"
    android:background="@null"
    android:button="@drawable/oculo_panel_switch"
    android:clickable="false"
    android:duplicateParentState="true"
    android:focusable="false" />
