<!-- MOD: Checkbox alignment in mixed item type dialogs (checkboxes, toggles, nested categories, etc.). -->
<!-- NOTE: Use negative margin because a checkbox is image drawable. -->
<!-- Added: android:layout_marginStart="-6dp" -->
<!-- Layout used by CheckBoxPreference for the checkbox style. This is inflated
     inside android.R.layout.preference. -->
<CheckBox
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/checkbox"
    android:duplicateParentState="true"
    android:buttonTint="@color/oculo_list_control"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="-6dp"
    android:focusable="false"
    android:clickable="false"
    android:background="@null"/>
