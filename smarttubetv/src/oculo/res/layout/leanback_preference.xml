<?xml version="1.0" encoding="utf-8"?>
<!-- Oculo (0.11.0, M1; 0.12.0 Oculo panel): flavor copy of the upstream layout (smarttubetv/src/main/res/layout,
     itself leanback's), one row of a panel at the Settings card's sizes: white focus pill (drawable/oculo_list_focus),
     Roboto Condensed title, the current value at the right in Roboto (the summary: OculoPanel.decorate() gives list
     rows their value, upstream sets no summary in these drawers), then the widget at the right (switch instead of
     upstream's check box at the left, chevron for a row that opens a level). Re-sync if upstream changes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/oculo_list_focus"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/oculo_panel_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/oculo_panel_row_padding"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/oculo_panel_row_padding"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="11dp"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@android:id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="2"
        android:textColor="@color/oculo_list_title"
        android:textSize="@dimen/oculo_card_row_title" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxWidth="150dp"
        android:singleLine="true"
        android:textColor="@color/oculo_settings_value"
        android:textSize="@dimen/oculo_card_row_value" />

    <!-- Preference widget: switch (CheckBoxPreference) or chevron -->
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
